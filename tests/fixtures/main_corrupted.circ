<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="facing" val="west"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1">
    <tool name="AND Gate"/>
    <tool name="OR Gate"/>
    <tool name="NOT Gate"/>
    <tool name="XOR Gate"/>
  </lib>
  <main name="ALU"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="sim limit" val="1000"/>
  </options>
  <mappings>
    <tool lib="0" map="Button2" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="0" name="Pin">
      <a name="facing" val="south"/>
    </tool>
    <tool lib="1" name="AND Gate"/>
  </toolbar>
  <circuit name="Half Adder">
    <a name="circuit" val="Half Adder"/>
    <a name="clabel" val=""/>
    <comp lib="0" loc="(80,100)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(80,140)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="1" loc="(150,120)" name="XOR Gate">
      <a name="facing" val="east"/>
    </comp>
    <comp lib="1" loc="(150,180)" name="AND Gate">
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(220,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
    </comp>
    <comp lib="0" loc="(220,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Carry"/>
    </comp>
    <wire from="(80,100)" to="(130,100)"/>
    <wire from="(80,140)" to="(130,140)"/>
    <wire from="(150,120)" to="(220,120)"/>
    <wire from="(150,180)" to="(220,180)"/>
  </circuit>
  <circuit name="Full Adder">
    <a name="circuit" val="Full Adder"/>
    <a name="clabel" val=""/>
    <comp lib="0" loc="(70,90)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(70,130)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="0" loc="(70,170)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="Cin"/>
    </comp>
    <comp loc="(140,110)" name="Half Adder"/>
    <comp loc="(220,150)" name="Half Adder"/>
    <comp lib="1" loc="(300,170)" name="OR Gate">
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(360,130)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
    </comp>
    <comp lib="0" loc="(360,170)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Cout"/>
    </comp>
    <wire from="(70,90)" to="(140,90)"/>
    <wire from="(70,130)" to="(140,130)"/>
    <wire from="(70,170)" to="(220,170)"/>
    <wire from="(220,150)" to="(360,130)"/>
    <wire from="(300,170)" to="(360,170)"/>
  </circuit>
  <circuit name="Full Adder 32-bit">
    <a name="circuit" val="Full Adder 32-bit"/>
    <a name="clabel" val=""/>
    <comp lib="0" loc="(60,80)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(60,120)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(60,160)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="Cin"/>
    </comp>
    <comp loc="(160,100)" name="Full Adder"/>
    <comp loc="(160,200)" name="Broken Ghost Adder"/>
    <comp loc="(280,100)" name="Full Adder"/>
    <comp loc="(280,200)" name="Full Adder"/>
    <comp lib="0" loc="(400,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(400,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Cout"/>
    </comp>
    <wire from="(60,80)" to="(160,80)"/>
    <wire from="BOGUS" to="(160,120)"/>
    <wire from="(60,160)" to="(160,160)"/>
    <wire from="(280,100)" to="(400,120)"/>
    <wire from="(280,200)" to="(400,180)"/>
  </circuit>
  <circuit name="Multiplier 4-bit">
    <a name="circuit" val="Multiplier 4-bit"/>
    <comp lib="0" loc="(50,70)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="X"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(50,110)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="Y"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(140,90)" name="AND Gate">
      <a name="facing" val="east"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(220,90)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="P"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(50,70)" to="(120,70)"/>
    <wire from="(50,110)" to="(120,110)"/>
    <wire from="(140,90)" to="(220,90)"/>
  </circuit>
  <circuit name="ALU">
    <a name="circuit" val="ALU"/>
    <comp lib="0" loc="(40,60)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="A"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(40,100)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="B"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="0" loc="(40,140)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="Op"/>
      <a name="width" val="3"/>
    </comp>
    <comp loc="(180,80)" name="Full Adder 32-bit"/>
    <comp loc="(180,200)" name="Multiplier 4-bit"/>
    <comp lib="0" loc="(340,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Result"/>
      <a name="width" val="32"/>
    </comp>
    <wire from="(40,60)" to="(180,60)"/>
    <wire from="(40,100)" to="(180,100)"/>
    <wire from="(180,80)" to="(340,120)"/>
  </circuit>
</project>
